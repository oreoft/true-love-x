# True Love Base Configuration
# Copy this file to config.yaml and modify as needed

# This file is shared by every base. Each base runs one bot (one WeChat account); the deploy injects
# its wxid as the BOT_ID environment variable, and base reads its own entry from this map.
# Base refuses to start when BOT_ID is missing from the map, and does not take over a WeChat
# that is logged in to any other account.
# master: the nickname that gets startup/shutdown notices, and everything sent with is_master.
bots:
  wxid_your_bot_wxid:
    master: "your_friend_nickname"

# HTTP token for authentication with backend server
http_token: "your_secret_token"

# The server address lives in true_love_common/hosts.py. Base reports its own tailnet address
# to the server on every call, so the server knows where to call it back.

# Chat listeners are kept in the server's database, per bot. When WeChat connects, base fetches
# them from the server, retrying for a few minutes; the server restores them after it starts.
# Add or remove listeners from tl-admin on the server.

# Loki log shipping (optional). Leave enable: false to log to the console only.
loki:
  enable: false
  loki_url: "https://your-loki-host"  # /loki/api/v1/push is appended automatically
  user_id: "your_loki_user_id"
  api_key: "your_loki_api_key"
